#!/bin/sh
# Redoubt :: hook git pre-push — LINT + TIPOS + SUITE. Bloqueia o push se algo quebrar.
# Instale com  install-hooks.bat  (copia este arquivo para .git/hooks/pre-push).
# Coexiste com o pre-commit anti-segredo (arquivos distintos).
# Emergencia (pular a checagem):  git push --no-verify
#
# ruff/mypy AUSENTES nao bloqueiam: o guarda-corpo obrigatorio e a suite, e o CI
# (.github/workflows/ci.yml) roda as tres checagens de qualquer forma. Travar o push de quem
# ainda nao instalou as ferramentas seria pior que avisar alto.
# Instale com:  pip install -r requirements-dev.txt
root="$(git rev-parse --show-toplevel)"

# O Python do projeto: `python`, ou `python3` nas distros que so tem esse nome.
PY="$(command -v python || command -v python3)"
if [ -z "$PY" ]; then
    echo "[pre-push] BLOQUEADO: Python nao encontrado no PATH (nem python, nem python3)."
    exit 1
fi

# Acha a ferramenta: o executavel no PATH ou, se o pip instalou os scripts FORA do PATH (comum
# no Windows com `pip install --user`), o modulo pelo proprio Python. Imprime o comando ou nada.
find_tool() {
    if command -v "$1" >/dev/null 2>&1; then
        echo "$1"
    elif "$PY" -m "$1" --version >/dev/null 2>&1; then
        echo "\"$PY\" -m $1"
    fi
}

echo "[pre-push] ruff (lint)..."
RUFF="$(find_tool ruff)"
if [ -n "$RUFF" ]; then
    if ! (cd "$root" && eval "$RUFF check ."); then
        echo ""
        echo "[pre-push] BLOQUEADO: o ruff reprovou. Boa parte sai com 'ruff check . --fix';"
        echo "           em emergencia, 'git push --no-verify'."
        exit 1
    fi
else
    echo "[pre-push] AVISO: ruff nao instalado — lint PULADO (pip install -r requirements-dev.txt)"
fi

echo "[pre-push] mypy (tipos nos nucleos puros)..."
MYPY="$(find_tool mypy)"
if [ -n "$MYPY" ]; then
    if ! (cd "$root" && eval "$MYPY"); then
        echo ""
        echo "[pre-push] BLOQUEADO: o mypy reprovou (escopo e config em pyproject.toml)."
        echo "           Corrija ou use 'git push --no-verify'."
        exit 1
    fi
else
    echo "[pre-push] AVISO: mypy nao instalado — checagem de tipos PULADA"
fi

echo "[pre-push] rodando a suite do Redoubt antes de empurrar (--no-verify pula)..."
if ! "$PY" "$root/tools/run_tests.py"; then
    echo ""
    echo "[pre-push] BLOQUEADO: a suite falhou. Corrija os testes ou use 'git push --no-verify'."
    exit 1
fi
echo "[pre-push] lint + tipos + suite verdes — seguindo com o push."
exit 0
